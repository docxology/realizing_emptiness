{
  "$id": "realizing_emptiness.pymdp_profile_comparison.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Realizing Emptiness pymdp Profile Comparison",
  "type": "object",
  "required": ["schema", "rows", "posterior_normalized", "runtime_dependency_check", "claim_boundary"],
  "properties": {
    "schema": {"const": "realizing_emptiness.pymdp_profile_comparison.v3"},
    "rows": {"type": "array", "minItems": 3, "items": {"type": "object"}},
    "posterior_normalized": {"const": true},
    "seed": {"type": "integer"}, "steps": {"type": "integer", "minimum": 1}, "channels": {"type": "integer", "minimum": 1},
    "state_labels": {"type": "array"}, "observation_labels": {"type": "array"}, "action_labels": {"type": "array"},
    "trajectory": {"type": "array"}, "policy_trace_summary": {"type": "array"},
    "generative_model_summary": {"type": "object"}, "posterior_sum": {"type": "number"}, "best_profile": {"type": "string"},
    "policy_trace_all_posteriors_normalized": {"type": "boolean"},
    "runtime_dependency_check": {"$ref": "#/$defs/runtime_dependency_check"},
    "claim_boundary": {"type": "string", "pattern": "not empirical"}
  },
  "$defs": {
    "runtime_dependency_check": {
      "type": "object", "required": ["schema", "ok", "version", "required_version", "version_ok", "policy_posterior_normalized", "warnings"],
      "properties": {
        "schema": {"const": "realizing_emptiness.pymdp_runtime_dependency_check.v1"},
        "ok": {"const": true}, "version": {"const": "1.0.3"}, "required_version": {"const": "1.0.3"}, "version_ok": {"const": true},
        "agent_class": {"const": "Agent"}, "state_factor_count": {"type": "integer", "minimum": 1},
        "policy_posterior_sum": {"type": "number"}, "policy_posterior_normalized": {"const": true},
        "neg_efe_shape": {"type": "array", "items": {"type": "integer"}}, "vfe_available": {"type": "boolean"},
        "warnings": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
