{
  "$id": "realizing_emptiness.general_measurement_cover_polytope_audit.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Realizing Emptiness General Measurement Cover Polytope Audit",
  "type": "object",
  "required": ["schema", "scenario_count", "row_count", "probability_row_count", "outcome_alphabet", "rows", "probability_rows", "controls", "all_controls_pass", "claim_boundary"],
  "properties": {
    "schema": {"const": "realizing_emptiness.general_measurement_cover_polytope_audit.v1"},
    "scenario_count": {"type": "integer", "minimum": 4},
    "row_count": {"type": "integer", "minimum": 4},
    "probability_row_count": {"type": "integer", "minimum": 24},
    "outcome_alphabet": {"type": "array", "items": {"type": "integer"}},
    "rows": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "global_section_feasible", "expected_feasible", "min_l1_residual", "no_disturbance_max_error", "parser_roundtrip_contexts"],
        "properties": {
          "id": {"type": "string"},
          "global_section_feasible": {"type": "boolean"},
          "expected_feasible": {"type": "boolean"},
          "min_l1_residual": {"type": "number", "minimum": 0},
          "no_disturbance_max_error": {"type": "number", "minimum": 0},
          "parser_roundtrip_contexts": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "probability_rows": {"type": "array", "minItems": 24, "items": {"type": "object"}},
    "controls": {"type": "object", "additionalProperties": {"const": true}},
    "all_controls_pass": {"const": true},
    "claim_boundary": {"type": "string", "pattern": "not empirical"}
  },
  "additionalProperties": false
}
