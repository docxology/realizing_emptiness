{
  "$id": "realizing_emptiness.visual_caption_audit.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Realizing Emptiness Visual Caption Audit",
  "type": "object",
  "required": [
    "schema",
    "figure_count",
    "row_count",
    "rows",
    "missing_or_weak_captions",
    "missing_source_artifacts",
    "missing_interpretive_boundaries",
    "missing_visual_encodings",
    "ok"
  ],
  "properties": {
    "schema": {"const": "realizing_emptiness.visual_caption_audit.v1"},
    "figure_count": {"type": "integer", "minimum": 1},
    "row_count": {"type": "integer", "minimum": 1},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "caption_length",
          "source_artifact_count",
          "has_source_artifact",
          "has_interpretive_boundary",
          "has_visual_encoding",
          "visual_encoding",
          "ok"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "caption_length": {"type": "integer", "minimum": 120},
          "source_artifact_count": {"type": "integer", "minimum": 1},
          "has_source_artifact": {"const": true},
          "has_interpretive_boundary": {"const": true},
          "has_visual_encoding": {"const": true},
          "visual_encoding": {"type": "string", "minLength": 20},
          "ok": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "missing_or_weak_captions": {"type": "array", "maxItems": 0},
    "missing_source_artifacts": {"type": "array", "maxItems": 0},
    "missing_interpretive_boundaries": {"type": "array", "maxItems": 0},
    "missing_visual_encodings": {"type": "array", "maxItems": 0},
    "ok": {"const": true}
  },
  "additionalProperties": false
}
