{
  "$id": "realizing_emptiness.quantum_trajectory_unraveling.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Realizing Emptiness Quantum Trajectory Unraveling",
  "type": "object",
  "required": ["schema", "seed", "trajectory_count", "step_count", "time_grid", "decoherence_rate_grid", "rows", "jump_count_rows", "invalid_controls", "controls", "max_trace_distance_to_exact", "all_controls_pass", "claim_boundary"],
  "properties": {
    "schema": {"const": "realizing_emptiness.quantum_trajectory_unraveling.v1"},
    "seed": {"type": "integer"},
    "trajectory_count": {"type": "integer", "minimum": 1},
    "step_count": {"type": "integer", "minimum": 1},
    "time_grid": {"type": "array", "minItems": 2, "items": {"type": "number"}},
    "decoherence_rate_grid": {"type": "array", "minItems": 2, "items": {"type": "number"}},
    "row_count": {"type": "integer", "minimum": 2},
    "jump_count_row_count": {"type": "integer", "minimum": 1},
    "rows": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "jump_count_rows": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "invalid_controls": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["id", "passes", "reason"], "properties": {"id": {"type": "string"}, "passes": {"const": true}, "reason": {"type": "string", "minLength": 20}}, "additionalProperties": false}},
    "controls": {"type": "object", "additionalProperties": {"const": true}},
    "max_norm_drift": {"type": "number", "minimum": 0},
    "max_trace_error": {"type": "number", "minimum": 0},
    "min_eigenvalue": {"type": "number"},
    "max_trace_distance_to_exact": {"type": "number", "minimum": 0, "maximum": 0.16},
    "all_controls_pass": {"const": true},
    "claim_boundary": {"type": "string", "pattern": "not empirical"}
  },
  "additionalProperties": false
}
