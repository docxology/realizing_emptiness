{
  "$id": "realizing_emptiness.figure_legibility_audit.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Realizing Emptiness Figure Legibility Audit",
  "type": "object",
  "required": ["schema", "minimum_width_px", "minimum_height_px", "minimum_readable_font_pt", "figure_count", "row_count", "rows", "undersized", "undersized_text", "missing_render_contract", "missing_legend_or_colorbar", "missing_source_data_alternative", "overlapping_text", "overlapping_titles", "cropped_text", "legend_axis_overlaps", "layout_failures", "ok", "claim_boundary"],
  "properties": {
    "schema": {"const": "realizing_emptiness.figure_legibility_audit.v1"},
    "minimum_width_px": {"const": 1200},
    "minimum_height_px": {"const": 600},
    "minimum_readable_font_pt": {"const": 12.0},
    "figure_count": {"type": "integer", "minimum": 1},
    "row_count": {"type": "integer", "minimum": 1},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "undersized": {"type": "array", "maxItems": 0},
    "undersized_text": {"type": "array", "maxItems": 0},
    "missing_render_contract": {"type": "array", "maxItems": 0},
    "missing_legend_or_colorbar": {"type": "array", "maxItems": 0},
    "missing_source_data_alternative": {"type": "array", "maxItems": 0},
    "overlapping_text": {"type": "array", "maxItems": 0},
    "overlapping_titles": {"type": "array", "maxItems": 0},
    "cropped_text": {"type": "array", "maxItems": 0},
    "legend_axis_overlaps": {"type": "array", "maxItems": 0},
    "layout_failures": {"type": "array", "maxItems": 0},
    "ok": {"const": true},
    "claim_boundary": {"type": "string", "pattern": "not empirical"}
  },
  "additionalProperties": false
}
