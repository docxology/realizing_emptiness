{
  "$id": "realizing_emptiness.bmr_alternative_prior_audit.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Realizing Emptiness BMR Alternative Prior Audit",
  "type": "object",
  "required": ["schema", "families", "access_grid", "precision_grid", "row_count", "rows", "weakest_prior", "weakest_prior_crossings", "crossing_shifts_vs_baseline", "controls", "all_controls_pass", "claim_boundary"],
  "properties": {
    "schema": {"const": "realizing_emptiness.bmr_alternative_prior_audit.v1"},
    "families": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "access_grid": {"type": "array", "minItems": 2, "items": {"type": "number"}},
    "precision_grid": {"type": "array", "minItems": 2, "items": {"type": "number"}},
    "row_count": {"type": "integer", "minimum": 1},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["family", "metacognitive_access", "prior_precision", "delta_free_energy", "prunes_prior", "verdict"], "additionalProperties": true}},
    "weakest_prior": {"type": "number"},
    "weakest_prior_crossings": {"type": "object"},
    "crossing_shifts_vs_baseline": {"type": "object"},
    "controls": {"type": "object", "required": ["baseline_family_included", "log_compressed_family_included", "convex_access_family_included", "all_verdicts_measured", "high_access_pruning_remains_bounded", "weakest_prior_crossings_measured", "at_least_one_crossing_shifts_vs_baseline", "claim_boundary_declares_not_empirical"], "additionalProperties": {"type": "boolean"}},
    "all_controls_pass": {"const": true},
    "claim_boundary": {"type": "string", "pattern": "not empirical"}
  },
  "additionalProperties": false
}
