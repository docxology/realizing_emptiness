{
  "$id": "realizing_emptiness.claim_support_audit.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Realizing Emptiness Claim Support Audit",
  "type": "object",
  "required": [
    "schema",
    "claim_registry",
    "registered_claim_count",
    "public_claim_count",
    "support_row_count",
    "support_rows",
    "claim_to_sources",
    "unknown_claim_ids",
    "unsupported_public_claims",
    "public_claims_without_gate",
    "ok"
  ],
  "properties": {
    "schema": {
      "const": "realizing_emptiness.claim_support_audit.v1"
    },
    "claim_registry": {
      "type": "array",
      "minItems": 1
    },
    "registered_claim_count": {
      "type": "integer",
      "minimum": 1
    },
    "public_claim_count": {
      "type": "integer",
      "minimum": 1
    },
    "support_row_count": {
      "type": "integer",
      "minimum": 1
    },
    "support_rows": {
      "type": "array",
      "minItems": 1
    },
    "claim_to_sources": {
      "type": "object"
    },
    "unknown_claim_ids": {
      "type": "array",
      "maxItems": 0
    },
    "unsupported_public_claims": {
      "type": "array",
      "maxItems": 0
    },
    "public_claims_without_gate": {
      "type": "array",
      "maxItems": 0
    },
    "ok": {
      "const": true
    }
  },
  "additionalProperties": false
}
