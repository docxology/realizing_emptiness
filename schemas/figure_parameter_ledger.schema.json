{
  "$id": "realizing_emptiness.figure_parameter_ledger.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Realizing Emptiness Figure Parameter Ledger",
  "type": "object",
  "required": ["schema", "figure_count", "row_count", "rows", "missing_rows", "rows_without_sources", "missing_source_artifacts", "controls", "all_controls_pass", "claim_boundary"],
  "properties": {
    "schema": {"const": "realizing_emptiness.figure_parameter_ledger.v1"},
    "figure_count": {"type": "integer", "minimum": 1},
    "row_count": {"type": "integer", "minimum": 1},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["figure_id", "path", "source_artifacts", "parameter_fields", "result_counts", "control_fields", "traceable", "claim_boundary"], "additionalProperties": true}},
    "missing_rows": {"type": "array", "items": {"type": "string"}},
    "rows_without_sources": {"type": "array", "items": {"type": "string"}},
    "missing_source_artifacts": {"type": "array", "items": {"type": "object"}},
    "controls": {"type": "object", "required": ["one_row_per_manifest_figure", "all_rows_have_source_artifacts", "all_source_artifacts_exist", "all_rows_have_claim_boundary", "parameters_or_controls_present_where_available"], "additionalProperties": {"type": "boolean"}},
    "all_controls_pass": {"const": true},
    "claim_boundary": {"type": "string", "pattern": "not empirical"}
  },
  "additionalProperties": false
}
