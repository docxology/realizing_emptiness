{
  "$id": "realizing_emptiness.quantum_roadmap_readiness_matrix.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Realizing Emptiness Quantum Roadmap Readiness Matrix",
  "type": "object",
  "required": [
    "schema",
    "row_count",
    "implemented_count",
    "future_count",
    "columns",
    "rows",
    "controls",
    "forged_completed_future_row_control",
    "all_controls_pass",
    "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "realizing_emptiness.quantum_roadmap_readiness_matrix.v1"},
    "row_count": {"type": "integer", "minimum": 1},
    "implemented_count": {"type": "integer", "minimum": 1},
    "future_count": {"type": "integer", "minimum": 1},
    "columns": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "enum": [
          "has_artifact",
          "has_schema",
          "has_validator",
          "has_negative_control",
          "manuscript_claim_allowed"
        ]
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "roadmap_class",
          "readiness_state",
          "readiness_score",
          "has_artifact",
          "has_schema",
          "has_validator",
          "has_negative_control",
          "manuscript_claim_allowed",
          "current_artifact",
          "current_schema",
          "current_validation_gate",
          "required_next_artifact",
          "required_next_gate",
          "required_negative_control",
          "boundary"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
          "blocked_task_id": {"type": "string", "pattern": "^re-[0-9]+$"},
          "roadmap_class": {"type": "string", "enum": ["implemented", "future"]},
          "readiness_state": {"type": "string", "minLength": 5},
          "readiness_score": {"type": "number", "minimum": 0, "maximum": 1},
          "has_artifact": {"type": "boolean"},
          "has_schema": {"type": "boolean"},
          "has_validator": {"type": "boolean"},
          "has_negative_control": {"const": true},
          "manuscript_claim_allowed": {"type": "boolean"},
          "current_artifact": {"type": "string"},
          "current_schema": {"type": "string"},
          "current_validation_gate": {"type": "string"},
          "required_next_artifact": {"type": "string", "minLength": 20},
          "required_next_gate": {"type": "string", "minLength": 10},
          "required_negative_control": {"type": "string", "minLength": 20},
          "boundary": {"type": "string", "pattern": "not"}
        },
        "allOf": [
          {
            "if": {"properties": {"roadmap_class": {"const": "implemented"}}},
            "then": {
              "properties": {
                "readiness_state": {"const": "validated_finite_simulation"},
                "readiness_score": {"const": 1.0},
                "has_artifact": {"const": true},
                "has_schema": {"const": true},
                "has_validator": {"const": true},
                "manuscript_claim_allowed": {"const": true},
                "current_artifact": {"type": "string", "minLength": 10},
                "current_schema": {"type": "string", "minLength": 10},
                "current_validation_gate": {"type": "string", "minLength": 10}
              }
            }
          },
          {
            "if": {"properties": {"roadmap_class": {"const": "future"}}},
            "then": {
              "required": ["blocked_task_id"],
              "properties": {
                "readiness_score": {"const": 0.0},
                "has_artifact": {"const": false},
                "has_schema": {"const": false},
                "has_validator": {"const": false},
                "manuscript_claim_allowed": {"const": false},
                "current_artifact": {"const": ""},
                "current_schema": {"const": ""},
                "current_validation_gate": {"const": ""}
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "controls": {
      "type": "object",
      "required": [
        "all_implemented_validated",
        "all_future_blocked",
        "every_future_has_next_gate",
        "every_row_has_negative_control",
        "every_row_has_boundary",
        "forged_completed_future_row_rejected"
      ],
      "properties": {
        "all_implemented_validated": {"const": true},
        "all_future_blocked": {"const": true},
        "every_future_has_next_gate": {"const": true},
        "every_row_has_negative_control": {"const": true},
        "every_row_has_boundary": {"const": true},
        "forged_completed_future_row_rejected": {"const": true}
      },
      "additionalProperties": false
    },
    "forged_completed_future_row_control": {
      "type": "object",
      "required": [
        "id",
        "blocked_task_id",
        "roadmap_class",
        "readiness_state",
        "readiness_score",
        "has_artifact",
        "has_schema",
        "has_validator",
        "has_negative_control",
        "manuscript_claim_allowed",
        "current_artifact",
        "current_schema",
        "current_validation_gate",
        "required_next_artifact",
        "required_next_gate",
        "required_negative_control",
        "boundary"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^re-[0-9]+$"},
        "blocked_task_id": {"type": "string", "pattern": "^re-[0-9]+$"},
        "roadmap_class": {"const": "future"},
        "readiness_state": {"const": "implemented_finite_simulation"},
        "readiness_score": {"const": 0.0},
        "has_artifact": {"const": false},
        "has_schema": {"const": false},
        "has_validator": {"const": false},
        "has_negative_control": {"const": true},
        "manuscript_claim_allowed": {"const": false},
        "current_artifact": {"const": ""},
        "current_schema": {"const": ""},
        "current_validation_gate": {"const": ""},
        "required_next_artifact": {"type": "string", "minLength": 20},
        "required_next_gate": {"type": "string", "minLength": 10},
        "required_negative_control": {"type": "string", "minLength": 20},
        "boundary": {"type": "string", "pattern": "not"}
      },
      "additionalProperties": false
    },
    "all_controls_pass": {"const": true},
    "claim_boundary": {"type": "string", "pattern": "not empirical"}
  },
  "additionalProperties": false
}
