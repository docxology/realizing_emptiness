{
  "$id": "realizing_emptiness.claim_redteam_audit.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Realizing Emptiness Claim RedTeam Audit",
  "type": "object",
  "required": [
    "schema",
    "claim_count",
    "rows",
    "missing_sections",
    "unresolved_sections",
    "missing_figure_bindings",
    "unresolved_figure_bindings",
    "missing_boundaries",
    "missing_source_roles",
    "missing_artifacts_or_gates",
    "reader_overclaims",
    "risky_claim_sentences",
    "controls",
    "all_controls_pass",
    "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "realizing_emptiness.claim_redteam_audit.v1"},
    "claim_count": {"type": "integer", "minimum": 1},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "evidence_class",
          "artifact",
          "artifact_exists",
          "validation_gate",
          "source_role_count",
          "source_themes",
          "manuscript_sections",
          "section_count",
          "section_anchors_resolve",
          "unresolved_sections",
          "figure_bindings",
          "figure_bindings_resolve",
          "unresolved_figure_bindings",
          "allowed_interpretation",
          "prohibited_inference",
          "future_evidence_required",
          "evidence_ceiling",
          "support_count",
          "reader_overclaim_phrases",
          "row_controls_pass",
          "failure_reasons",
          "redteam_note"
        ],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "evidence_class": {"type": "string", "minLength": 3},
          "artifact": {"type": "string", "minLength": 3},
          "artifact_exists": {"const": true},
          "validation_gate": {"type": "string", "minLength": 3},
          "source_role_count": {"type": "integer", "minimum": 1},
          "source_themes": {"type": "array", "items": {"type": "string"}},
          "manuscript_sections": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^sec:"}},
          "section_count": {"type": "integer", "minimum": 1},
          "section_anchors_resolve": {"const": true},
          "unresolved_sections": {"type": "array", "maxItems": 0},
          "figure_bindings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "figure_bindings_resolve": {"const": true},
          "unresolved_figure_bindings": {"type": "array", "maxItems": 0},
          "allowed_interpretation": {"type": "string", "minLength": 20},
          "prohibited_inference": {"type": "string", "minLength": 20},
          "future_evidence_required": {"type": "string", "minLength": 20},
          "evidence_ceiling": {"type": "string", "minLength": 10},
          "support_count": {"type": "integer", "minimum": 1},
          "reader_overclaim_phrases": {"type": "array", "maxItems": 0},
          "row_controls_pass": {"const": true},
          "failure_reasons": {"type": "array", "maxItems": 0},
          "redteam_note": {"type": "string", "minLength": 20}
        },
        "additionalProperties": false
      }
    },
    "missing_sections": {"type": "array", "maxItems": 0},
    "unresolved_sections": {"type": "array", "maxItems": 0},
    "missing_figure_bindings": {"type": "array", "maxItems": 0},
    "unresolved_figure_bindings": {"type": "array", "maxItems": 0},
    "missing_boundaries": {"type": "array", "maxItems": 0},
    "missing_source_roles": {"type": "array", "maxItems": 0},
    "missing_artifacts_or_gates": {"type": "array", "maxItems": 0},
    "reader_overclaims": {"type": "array", "maxItems": 0},
    "risky_claim_sentences": {"type": "array", "maxItems": 0},
    "controls": {
      "type": "object",
      "required": [
        "all_public_claims_joined",
        "claim_count_matches_crosswalk",
        "all_claims_have_source_roles",
        "all_claims_have_artifacts_and_gates",
        "all_claims_have_reader_locations",
        "all_section_anchors_resolve",
        "all_claims_have_figure_bindings",
        "all_figure_bindings_resolve",
        "all_claim_boundaries_complete",
        "no_reader_overclaims",
        "claim_context_controls_pass",
        "claim_support_audit_pass",
        "evidence_ceiling_controls_pass",
        "source_argument_coverage_pass",
        "manuscript_claim_audit_pass",
        "manuscript_claim_intensity_pass"
      ],
      "properties": {
        "all_public_claims_joined": {"const": true},
        "claim_count_matches_crosswalk": {"const": true},
        "all_claims_have_source_roles": {"const": true},
        "all_claims_have_artifacts_and_gates": {"const": true},
        "all_claims_have_reader_locations": {"const": true},
        "all_section_anchors_resolve": {"const": true},
        "all_claims_have_figure_bindings": {"const": true},
        "all_figure_bindings_resolve": {"const": true},
        "all_claim_boundaries_complete": {"const": true},
        "no_reader_overclaims": {"const": true},
        "claim_context_controls_pass": {"const": true},
        "claim_support_audit_pass": {"const": true},
        "evidence_ceiling_controls_pass": {"const": true},
        "source_argument_coverage_pass": {"const": true},
        "manuscript_claim_audit_pass": {"const": true},
        "manuscript_claim_intensity_pass": {"const": true}
      },
      "additionalProperties": false
    },
    "all_controls_pass": {"const": true},
    "claim_boundary": {"type": "string", "pattern": "not empirical"}
  },
  "additionalProperties": false
}
