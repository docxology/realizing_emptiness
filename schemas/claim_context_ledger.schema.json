{
  "$id": "realizing_emptiness.claim_context_ledger.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Realizing Emptiness Claim Context Ledger",
  "type": "object",
  "required": [
    "schema",
    "claim_count",
    "rows",
    "missing_reader_claims",
    "missing_source_roles",
    "unresolved_source_keys",
    "missing_artifacts",
    "missing_gates",
    "missing_allowed_interpretations",
    "missing_prohibited_interpretations",
    "missing_future_evidence",
    "missing_manuscript_sections",
    "missing_figure_bindings",
    "role_compatibility_failures",
    "proxy_overclaiming_reader_claims",
    "controls",
    "all_controls_pass",
    "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "realizing_emptiness.claim_context_ledger.v1"},
    "claim_count": {"type": "integer", "minimum": 1},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "reader_claim",
          "paper_locator",
          "allowed_interpretation",
          "prohibited_inference",
          "source_roles",
          "source_keys",
          "source_role_count",
          "artifact",
          "artifact_exists",
          "validation_gate",
          "evidence_class",
          "evidence_ceiling",
          "stressors",
          "future_evidence_required",
          "manuscript_sections",
          "figure_bindings",
          "role_compatibility",
          "support_count"
        ],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "reader_claim": {"type": "string", "minLength": 20},
          "paper_locator": {"type": "string", "minLength": 3},
          "allowed_interpretation": {"type": "string", "minLength": 40},
          "prohibited_inference": {"type": "string", "minLength": 20},
          "source_roles": {"type": "array", "minItems": 1},
          "source_keys": {"type": "array", "minItems": 1},
          "source_role_count": {"type": "integer", "minimum": 1},
          "artifact": {"type": "string", "minLength": 3},
          "artifact_exists": {"const": true},
          "validation_gate": {"type": "string", "minLength": 3},
          "evidence_class": {"type": "string", "minLength": 3},
          "evidence_ceiling": {"type": "string", "minLength": 10},
          "stressors": {"type": "array", "minItems": 1},
          "future_evidence_required": {"type": "string", "minLength": 20},
          "manuscript_sections": {"type": "array", "minItems": 1},
          "figure_bindings": {"type": "array", "minItems": 1},
          "role_compatibility": {
            "type": "object",
            "required": ["rule", "ok", "rationale"],
            "properties": {
              "rule": {"type": "string", "minLength": 3},
              "ok": {"const": true},
              "rationale": {"type": "string", "minLength": 20}
            },
            "additionalProperties": false
          },
          "support_count": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "missing_reader_claims": {"type": "array", "maxItems": 0},
    "missing_source_roles": {"type": "array", "maxItems": 0},
    "unresolved_source_keys": {"type": "array", "maxItems": 0},
    "missing_artifacts": {"type": "array", "maxItems": 0},
    "missing_gates": {"type": "array", "maxItems": 0},
    "missing_allowed_interpretations": {"type": "array", "maxItems": 0},
    "missing_prohibited_interpretations": {"type": "array", "maxItems": 0},
    "missing_future_evidence": {"type": "array", "maxItems": 0},
    "missing_manuscript_sections": {"type": "array", "maxItems": 0},
    "missing_figure_bindings": {"type": "array", "maxItems": 0},
    "role_compatibility_failures": {"type": "array", "maxItems": 0},
    "proxy_overclaiming_reader_claims": {"type": "array", "maxItems": 0},
    "controls": {
      "type": "object",
      "required": [
        "all_public_claims_represented",
        "all_reader_claims_present",
        "all_source_roles_present",
        "all_source_keys_resolve",
        "all_artifacts_exist",
        "all_gates_declared",
        "all_allowed_interpretations_present",
        "all_prohibited_interpretations_present",
        "all_future_evidence_boundaries_present",
        "all_manuscript_sections_present",
        "all_figure_bindings_present",
        "all_role_compatibility_rules_pass",
        "no_proxy_or_safety_reader_overclaims"
      ],
      "properties": {
        "all_public_claims_represented": {"const": true},
        "all_reader_claims_present": {"const": true},
        "all_source_roles_present": {"const": true},
        "all_source_keys_resolve": {"const": true},
        "all_artifacts_exist": {"const": true},
        "all_gates_declared": {"const": true},
        "all_allowed_interpretations_present": {"const": true},
        "all_prohibited_interpretations_present": {"const": true},
        "all_future_evidence_boundaries_present": {"const": true},
        "all_manuscript_sections_present": {"const": true},
        "all_figure_bindings_present": {"const": true},
        "all_role_compatibility_rules_pass": {"const": true},
        "no_proxy_or_safety_reader_overclaims": {"const": true}
      },
      "additionalProperties": false
    },
    "all_controls_pass": {"const": true},
    "claim_boundary": {"type": "string", "pattern": "not empirical"}
  },
  "additionalProperties": false
}
