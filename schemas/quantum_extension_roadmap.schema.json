{
  "$id": "realizing_emptiness.quantum_extension_roadmap.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Realizing Emptiness Quantum Extension Roadmap",
  "type": "object",
  "required": [
    "schema",
    "implemented_count",
    "future_count",
    "implemented",
    "future",
    "success_criteria",
    "all_implemented_have_artifacts",
    "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "realizing_emptiness.quantum_extension_roadmap.v1"},
    "implemented_count": {"type": "integer", "minimum": 1},
    "future_count": {"type": "integer", "minimum": 1},
    "implemented": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "artifact", "validation_gate", "next_extension", "boundary"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
          "status": {"const": "implemented_finite_simulation"},
          "artifact": {"type": "string", "minLength": 3},
          "validation_gate": {"type": "string", "minLength": 3},
          "next_extension": {"type": "string", "minLength": 20},
          "boundary": {"type": "string", "minLength": 20}
        },
        "additionalProperties": false
      }
    },
    "future": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "blocked_task_id",
          "status",
          "minimum_next_test",
          "required_next_artifact",
          "required_next_gate",
          "required_negative_control",
          "boundary"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^re-[0-9]+$"},
          "blocked_task_id": {"type": "string", "pattern": "^re-[0-9]+$"},
          "status": {"type": "string", "pattern": "^roadmap_requires_"},
          "minimum_next_test": {"type": "string", "minLength": 20},
          "required_next_artifact": {"type": "string", "minLength": 20},
          "required_next_gate": {"type": "string", "minLength": 10},
          "required_negative_control": {"type": "string", "minLength": 20},
          "boundary": {"type": "string", "pattern": "not"}
        },
        "additionalProperties": false
      }
    },
    "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "all_implemented_have_artifacts": {"const": true},
    "claim_boundary": {"type": "string", "pattern": "not empirical"}
  },
  "additionalProperties": false
}
