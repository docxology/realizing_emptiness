{
  "$id": "realizing_emptiness.sheaf_coverage_matrix.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Realizing Emptiness Sheaf Coverage Matrix",
  "type": "object",
  "required": ["schema", "section_count", "track_count", "rows", "missing_count", "ok"],
  "properties": {
    "schema": {"const": "realizing_emptiness.sheaf_coverage_matrix.v1"},
    "section_count": {"type": "integer", "minimum": 1},
    "track_count": {"type": "integer", "minimum": 1},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "missing_count": {"const": 0},
    "ok": {"const": true}
  },
  "additionalProperties": false
}
